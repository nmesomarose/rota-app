# Database Configuration (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rota
DB_USER=postgres
DB_PASSWORD=postgres

# Superuser / Admin connection for running migrations & schema setup
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rota

# Application connection (non-superuser without BYPASSRLS)
APP_DB_USER=rota_app
APP_DB_PASSWORD=rota_dev_app_password
APP_DATABASE_URL=postgresql://rota_app:rota_dev_app_password@localhost:5432/rota

# Shard and Control Plane Schemas
CONTROL_SCHEMA=rota_control
SHARD_1_SCHEMA=rota_shard_1
SHARD_2_SCHEMA=rota_shard_2

# Application Runtime
NODE_ENV=development
PORT=3000

# Security & Authentication Placeholders (DO NOT USE REAL SECRETS HERE)
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars
REFRESH_TOKEN_SECRET=replace_with_a_secure_random_string_at_least_32_chars
