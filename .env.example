# ==============================================================================
# Rota Backend Environment Variables Template
# ==============================================================================
# Copy this file to .env for local development or configure these variables in
# your production secret store / container orchestration platform (e.g. AWS ECS,
# Kubernetes, Fly.io, Railway, Render).
#
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION RUNTIME & NETWORKING
# ------------------------------------------------------------------------------
# Set to 'production' for production deployments.
# Setting NODE_ENV=production enforces strict validation (e.g. mandatory REDIS_URL).
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Express Trust Proxy: Configure based on your reverse proxy / ingress setup.
# Options: 'false' (direct connection), 'true' (trust all headers), or integer hop count e.g. '1' (behind AWS ALB, Cloudflare, NGINX).
# Defaulting to 'false' prevents IP spoofing in rate-limiting middleware.
TRUST_PROXY=1

# Public Base URL for this API service (used for webhook callbacks and redirects)
APP_BASE_URL=https://api.yourdomain.com

# ------------------------------------------------------------------------------
# 2. DATABASE CREDENTIALS & SEPARATION OF PRIVILEGES
# ------------------------------------------------------------------------------
# Strict separation of duties:
# 1) DATABASE_URL: Administrative / superuser connection used EXCLUSIVELY by
#    database migrations (scripts/init-db.ts, scripts/migrate.ts) to manage schemas,
#    run DDL, and grant least-privilege permissions.
# 2) APP_DATABASE_URL: Unprivileged application role connection used by the running
#    API server and queue workers. This role MUST NOT have BYPASSRLS or SUPERUSER.
# ------------------------------------------------------------------------------
# Admin / Migration connection string (DDL migrations only)
DATABASE_URL=postgresql://db_admin_user:YOUR_ADMIN_PASSWORD@postgres-host:5432/rota_prod?sslmode=require

# Application runtime connection string (Least-privilege DML role)
APP_DATABASE_URL=postgresql://rota_app:YOUR_APP_ROLE_PASSWORD@postgres-host:5432/rota_prod?sslmode=require

# Dedicated PostgreSQL Shard Databases (PRD 9.1, DR-04, Phase 2)
# If not explicitly specified, defaults are automatically derived by replacing the database path with /rota_shard_1 and /rota_shard_2.
SHARD_1_DATABASE_URL=postgresql://db_admin_user:YOUR_ADMIN_PASSWORD@postgres-host:5432/rota_shard_1?sslmode=require
APP_SHARD_1_DATABASE_URL=postgresql://rota_app:YOUR_APP_ROLE_PASSWORD@postgres-host:5432/rota_shard_1?sslmode=require
SHARD_2_DATABASE_URL=postgresql://db_admin_user:YOUR_ADMIN_PASSWORD@postgres-host:5432/rota_shard_2?sslmode=require
APP_SHARD_2_DATABASE_URL=postgresql://rota_app:YOUR_APP_ROLE_PASSWORD@postgres-host:5432/rota_shard_2?sslmode=require

# Database Schema Names (Control plane and tenant shard schemas)
CONTROL_SCHEMA=rota_control
SHARD_1_SCHEMA=rota_shard_1
SHARD_2_SCHEMA=rota_shard_2

# ------------------------------------------------------------------------------
# 3. REDIS PERSISTENCE & QUEUE STORE
# ------------------------------------------------------------------------------
# MANDATORY in production. Used for distributed rate limiting, cache layer,
# and background job queues with at-least-once delivery guarantees.
# Use rediss:// (TLS) for managed cloud providers (e.g., AWS ElastiCache, Upstash).
REDIS_URL=rediss://default:YOUR_REDIS_PASSWORD@redis-host:6379

# ------------------------------------------------------------------------------
# 4. SECURITY & CRYPTOGRAPHIC SECRETS
# ------------------------------------------------------------------------------
# Generate high-entropy strings (e.g. `openssl rand -base64 32`) for production.
# NEVER reuse secrets across environments or commit default values.
JWT_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS
REFRESH_TOKEN_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY (PAYSTACK)
# ------------------------------------------------------------------------------
# Required for subscription billing, checkout, and webhook reconciliation.
# In production, use live keys ('sk_live_...', 'pk_live_...').
PAYSTACK_SECRET_KEY=sk_live_YOUR_PAYSTACK_SECRET_KEY
PAYSTACK_PUBLIC_KEY=pk_live_YOUR_PAYSTACK_PUBLIC_KEY
PAYSTACK_CALLBACK_URL=https://api.yourdomain.com/v1/billing/return

# Set to 'true' to defer webhook execution to background worker queue (recommended for high throughput)
ASYNC_WEBHOOK_PROCESSING=true

# ------------------------------------------------------------------------------
# 6. BACKGROUND QUEUE & WORKER TUNING
# ------------------------------------------------------------------------------
# Maximum number of retry attempts before a failed job is moved to DLQ (rota:queue:dead_letter)
QUEUE_MAX_ATTEMPTS=3

# Initial retry backoff in milliseconds (uses exponential backoff on retries)
QUEUE_BACKOFF_MS=1000

# Visibility timeout in milliseconds: worker heartbeats renew claims at a 1/3 fraction
# of this window while processing. Stale/crashed worker jobs recover after this duration.
QUEUE_VISIBILITY_TIMEOUT_MS=30000

# Sweeper background scan interval in milliseconds
SWEEPER_INTERVAL_MS=60000

# ------------------------------------------------------------------------------
# 7. TRANSACTIONAL EMAIL PROVIDER (RESEND)
# ------------------------------------------------------------------------------
# In production, provide a live Resend API key ('re_...') to enable real email delivery.
# In development/test, unset RESEND_API_KEY to use the local in-memory simulated transport.
# To force simulated mode regardless of RESEND_API_KEY, set EMAIL_PROVIDER=simulated.
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
EMAIL_FROM="Rota <invitations@yourdomain.com>"
EMAIL_PROVIDER=resend

# ------------------------------------------------------------------------------
# 8. PUSH NOTIFICATION PROVIDER (EXPO)
# ------------------------------------------------------------------------------
# In production, default is 'expo' to deliver push notifications to physical devices.
# In development/test, defaults to 'simulated' in-memory delivery.
# Optional EXPO_ACCESS_TOKEN if your Expo account has enhanced push security enabled.
PUSH_PROVIDER=expo
EXPO_ACCESS_TOKEN=YOUR_OPTIONAL_EXPO_ACCESS_TOKEN



