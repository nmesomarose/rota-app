{
  "name": "rota-backend",
  "version": "0.1.0",
  "description": "Rota multi-tenant workforce scheduling system",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/**/*.test.ts",
    "test:sharding": "node --test --experimental-strip-types tests/sharding/shard-router.test.ts",
    "db:migrate:control": "node --experimental-strip-types scripts/migrate.ts control",
    "db:migrate:shards": "node --experimental-strip-types scripts/migrate.ts shards",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts all"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.11.11",
    "node-pg-migrate": "^9.0.0",
    "typescript": "^5.7.3"
  }
}
