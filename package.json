{
  "name": "rota-backend",
  "version": "0.1.0",
  "description": "Rota multi-tenant workforce scheduling system",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --experimental-strip-types src/index.ts",
    "start:combined": "node --experimental-strip-types src/combined.ts",
    "start:api": "node --experimental-strip-types src/index.ts",
    "start:worker": "node --experimental-strip-types src/worker.ts",
    "dev": "node --watch --watch-path=src --experimental-strip-types src/index.ts",
    "dev:worker": "node --watch --watch-path=src --experimental-strip-types src/worker.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --test-concurrency=1 tests/**/*.test.ts",
    "worker": "node --experimental-strip-types src/worker.ts",
    "migrate": "node --experimental-strip-types scripts/migrate.ts all",
    "test:sharding": "node --test --experimental-strip-types tests/sharding/shard-router.test.ts",
    "benchmark:caching": "node --experimental-strip-types scripts/benchmark-caching.ts",
    "benchmark:feed": "node --experimental-strip-types scripts/benchmark-activity-feed-redis.ts",
    "load-test:feed": "node --experimental-strip-types load-tests/activity-feed-benchmark.ts",
    "benchmark:explain": "node --experimental-strip-types scripts/explain-analyze.ts",
    "benchmark:explain-10k": "node --experimental-strip-types scripts/benchmark-explain-10k.ts",
    "drill:resilience": "node --experimental-strip-types scripts/pool-exhaustion-drill.ts",
    "verify:sharding": "node --experimental-strip-types scripts/verify-sharding-distribution.ts",
    "db:init": "node --experimental-strip-types scripts/init-db.ts",
    "db:setup-shards": "node --experimental-strip-types scripts/setup-shard-databases.ts",
    "db:reconcile": "node --experimental-strip-types scripts/reconcile-tenant-data.ts",
    "db:verify": "node --experimental-strip-types scripts/verify-shards.ts",
    "db:migrate:control": "node --experimental-strip-types scripts/migrate.ts control",
    "db:migrate:shards": "node --experimental-strip-types scripts/migrate.ts shards",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts all",
    "db:deploy": "node --experimental-strip-types scripts/init-db.ts && node --experimental-strip-types scripts/setup-shard-databases.ts && node --experimental-strip-types scripts/migrate.ts all"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.29.6",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.11.11",
    "typescript": "^5.7.3"
  }
}
